{
  "name": "@laminapdf/render-hayro",
  "version": "0.2.0-alpha.4",
  "description": "ADR 0004's second web renderer and CI oracle: laminapdf-render's hayro adapter as its own WebAssembly module (lamina_pdf_render_hayro in @laminapdf/wasm) behind @laminapdf/render's RenderBackend interface.",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://laminapdf.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laudebugs/laminapdf.git",
    "directory": "packages/render-hayro"
  },
  "keywords": [
    "pdf",
    "render",
    "hayro",
    "wasm"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:wasm": "tsc -p tsconfig.build.json",
    "typecheck:wasm": "tsc -p tsconfig.build.json && tsc --noEmit -p tsconfig.json",
    "test:wasm": "tsc -p tsconfig.build.json && tsc --noEmit -p tsconfig.json && vitest run -c vitest.node.config.ts"
  },
  "dependencies": {
    "@laminapdf/render": "workspace:*",
    "@laminapdf/wasm": "workspace:*"
  },
  "devDependencies": {
    "@laminapdf/test-utils": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
