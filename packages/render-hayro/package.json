{
  "name": "@laminapdf/render-hayro",
  "version": "0.2.0",
  "description": "Render PDF pages to RGBA pixels in the browser with hayro, a PDF renderer written in Rust and compiled to WebAssembly, behind @laminapdf/render's interface.",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://laminapdf.com",
  "bugs": {
    "url": "https://github.com/laudebugs/laminapdf/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laudebugs/laminapdf.git",
    "directory": "packages/render-hayro"
  },
  "keywords": [
    "pdf",
    "render",
    "rendering",
    "pdf-renderer",
    "hayro",
    "wasm",
    "webassembly"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:wasm": "tsc -p tsconfig.build.json",
    "typecheck:wasm": "tsc -p tsconfig.build.json && tsc --noEmit -p tsconfig.json",
    "test:wasm": "tsc -p tsconfig.build.json && tsc --noEmit -p tsconfig.json && vitest run -c vitest.node.config.ts"
  },
  "dependencies": {
    "@laminapdf/render": "workspace:*",
    "@laminapdf/wasm": "workspace:*"
  },
  "devDependencies": {
    "@laminapdf/test-utils": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
