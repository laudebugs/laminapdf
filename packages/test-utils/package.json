{
  "name": "@laminapdf/test-utils",
  "version": "0.0.0",
  "private": true,
  "description": "Test helpers the Lamina PDF packages share: the render contract suite, the browser harness and config, the Firefox workaround and the repository root. Workspace-only; never published or versioned.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    "./render-contract": "./src/render-contract.ts",
    "./browser-harness": "./src/browser-harness.ts",
    "./browser-config": "./src/browser-config.ts",
    "./firefox": "./src/firefox.ts",
    "./root": "./src/root.ts",
    "./worker-hooks": "./src/worker-hooks.ts",
    "./wrangler-dev": "./src/wrangler-dev.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@laminapdf/render": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
