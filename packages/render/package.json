{
  "name": "@lamina/render",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "The web render contract of ADR 0004: the RenderBackend interface @lamina/render-pdfium and @lamina/render-hayro implement, the tile planner they share, RenderError, and the contract test suite both run.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json && tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.build.json && vitest run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
