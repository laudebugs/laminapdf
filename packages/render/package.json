{
  "name": "@laminapdf/render",
  "version": "0.2.0-alpha.3",
  "description": "The web render contract of ADR 0004: the RenderBackend interface @laminapdf/render-pdfium and @laminapdf/render-hayro implement, the tile planner they share, and RenderError.",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://laminapdf.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laudebugs/laminapdf.git",
    "directory": "packages/render"
  },
  "keywords": [
    "pdf",
    "render",
    "renderer",
    "interface"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json && tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.build.json && vitest run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
