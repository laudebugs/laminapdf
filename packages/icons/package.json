{
  "name": "@laminapdf/icons",
  "version": "0.0.0",
  "private": true,
  "description": "Lamina PDF's Paper stroke icons: one SVG per icon, a framework-free module of their markup (ICONS, iconSvg) and a React <Icon> on its own subpath. Workspace-only for now.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "node scripts/generate.ts",
    "lint:icons": "node scripts/lint.ts",
    "gallery": "vite gallery",
    "typecheck": "tsc -p tsconfig.build.json && tsc --noEmit -p tsconfig.json",
    "test": "node scripts/generate.ts --check && tsc -p tsconfig.build.json && vitest run -c vitest.node.config.ts"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@laminapdf/test-utils": "workspace:*",
    "@laminapdf/tokens": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "axe-core": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
