---
// The sites' select: a button that opens a list of choices, each with its Paper icon,
// drawn as design language §7.26's listbox popup instead of the platform's own list. It is ARIA's
// select-only combobox: the button keeps the focus, the arrow keys move through the list, Enter or
// Space chooses, Escape closes. menu-select.ts gives it that behaviour (<site-menu-select>); the
// docs site's theme switch uses it (apps/docs/src/components/ThemeSelect.astro). The chosen value
// is the element's `value` attribute, and every element marked `data-for` shows only for its
// value, so a page's inline script can set both before the first paint. Its look is
// menu-select.css; no inline style, which the website's checks refuse.
import "./menu-select.css";
import check from "@laminapdf/icons/svg/check.svg?raw";
import chevron from "@laminapdf/icons/svg/chevron-down.svg?raw";
import { decorativeIcon } from "./icon.mjs";

export interface MenuSelectOption {
  /** The value the select takes. */
  value: string;
  /** The visible text. */
  label: string;
  /** A Paper icon's SVG, imported from `@laminapdf/icons/svg/<name>.svg?raw`. */
  icon: string;
}

interface Props {
  /** The select's name: shown before it, or for assistive technology only with `hideLabel`. */
  label: string;
  hideLabel?: boolean;
  options: readonly MenuSelectOption[];
  /** The value shown until a script sets another. */
  value: string;
}

const { label, hideLabel = false, options, value } = Astro.props;
---

<site-menu-select class="site-menu-select" value={value}>
  <span class:list={["site-menu-select-label", { "site-menu-select-label-hidden": hideLabel }]} aria-hidden="true"
    >{label}</span
  >
  {/* Named by aria-label, the label's own text, so it has its name before the script runs. */}
  <button
    type="button"
    role="combobox"
    class="site-menu-select-button"
    aria-label={label}
    aria-haspopup="listbox"
    aria-expanded="false"
  >
    {
      options.map((option) => (
        <span class="site-menu-select-current" data-for={option.value} hidden={option.value !== value}>
          <Fragment set:html={decorativeIcon(option.icon, "site-menu-select-icon")} />
          <span>{option.label}</span>
        </span>
      ))
    }
    <Fragment set:html={decorativeIcon(chevron, "site-menu-select-chevron")} />
  </button>
  <ul role="listbox" class="site-menu-select-list" aria-label={label} hidden>
    {
      options.map((option) => (
        <li
          role="option"
          class="site-menu-select-option"
          data-value={option.value}
          aria-selected={String(option.value === value)}
        >
          <Fragment set:html={decorativeIcon(option.icon, "site-menu-select-icon")} />
          <span class="site-menu-select-option-label">{option.label}</span>
          <Fragment set:html={decorativeIcon(check, "site-menu-select-check")} />
        </li>
      ))
    }
  </ul>
</site-menu-select>

<script>
  import { defineMenuSelect } from "./menu-select.ts";

  defineMenuSelect();
</script>
