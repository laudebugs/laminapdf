{
  "name": "@laminapdf/site-kit",
  "version": "0.0.0",
  "private": true,
  "description": "What Lamina PDF's two Astro sites share: the build steps (the CSP's inline-script hashes, noindex outside production, one robots.txt for every host, the website's checks of every built page) and the site header with its one list of links, and the select with an icon per choice. Runs at build time, but for the select's script; workspace-only, consumed as source.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./code-kinds": "./src/code-kinds.mjs",
    "./integrations": "./src/integrations.mjs",
    "./inline-styles": "./src/inline-styles.mjs",
    "./lastmod": "./src/lastmod.mjs",
    "./markup": "./src/markup.mjs",
    "./robots": "./src/robots.mjs",
    "./structured-data": "./src/structured-data.mjs",
    "./nav": "./src/nav.mjs",
    "./SiteHeader.astro": "./src/SiteHeader.astro",
    "./SiteNav.astro": "./src/SiteNav.astro",
    "./header.css": "./src/header.css",
    "./base.css": "./src/base.css",
    "./states.css": "./src/states.css",
    "./icon": "./src/icon.mjs",
    "./MenuSelect.astro": "./src/MenuSelect.astro",
    "./menu-select.css": "./src/menu-select.css",
    "./version": "./src/version.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@laminapdf/icons": "workspace:*",
    "shiki": "catalog:"
  },
  "devDependencies": {
    "@laminapdf/fonts": "workspace:*",
    "@laminapdf/test-utils": "workspace:*",
    "@laminapdf/tokens": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "astro": "7.4.10",
    "axe-core": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
