{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "extends": "//",
  "overrides": [
    {
      "includes": ["src/**", "examples/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          }
        }
      }
    },
    {
      "includes": ["src/loader/node.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          }
        }
      }
    },
    {
      "includes": ["src/worker/server.ts", "test/source.test.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    },
    {
      "includes": ["src/source/http.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "noExcessiveLinesPerFunction": "off"
          }
        }
      }
    },
    {
      "includes": ["examples/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "warn",
              "options": {
                "patterns": [
                  {
                    "group": ["../**", "**/src/**", "**/test/**", "**/fixtures/**"],
                    "message": "Examples import only public entry points (@laminapdf/sdk, @laminapdf/sdk/worker), never another folder of the repository: docs/guidelines/examples.md."
                  }
                ]
              }
            },
            "noNonNullAssertion": "warn"
          },
          "suspicious": {
            "noExplicitAny": "warn"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "warn",
              "options": {
                "maxAllowedComplexity": 10
              }
            },
            "noExcessiveLinesPerFunction": {
              "level": "warn",
              "options": {
                "maxLines": 40
              }
            }
          }
        }
      }
    },
    {
      "includes": ["examples/quick-start/node.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          }
        }
      }
    },
    {
      "includes": ["examples/quick-start/browser.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "window": "Shared packages must run outside browsers; take what you need as a parameter.",
                  "navigator": "Shared packages must run outside browsers; pass capabilities in from the caller.",
                  "localStorage": "Shared packages must not persist state; let the caller store it.",
                  "sessionStorage": "Shared packages must not persist state; let the caller store it.",
                  "location": "Shared packages must not depend on a page URL; pass it in.",
                  "HTMLElement": "Only browser UI packages may use DOM element types.",
                  "Buffer": "Node-only: use Uint8Array.",
                  "process": "Node-only: pass configuration in from the caller.",
                  "require": "ESM-only: use import.",
                  "__dirname": "Node-only and CommonJS-only: resolve paths in the caller.",
                  "__filename": "Node-only and CommonJS-only: resolve paths in the caller."
                }
              }
            }
          }
        }
      }
    }
  ]
}
