{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "extends": "//",
  "overrides": [
    {
      "includes": ["src/**", "examples/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          }
        }
      }
    },
    {
      "includes": ["src/loader/node.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          }
        }
      }
    },
    {
      "includes": ["src/worker/server.ts", "test/source.test.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    },
    {
      "includes": ["src/source/http.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "noExcessiveLinesPerFunction": "off"
          }
        }
      }
    },
    {
      "includes": ["examples/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "warn",
              "options": {
                "patterns": [
                  {
                    "group": ["../**", "**/src/**", "**/test/**", "**/fixtures/**"],
                    "message": "Examples import only public entry points (@laminapdf/sdk, @laminapdf/sdk/worker), never another folder of the repository: docs/guidelines/examples.md."
                  }
                ]
              }
            },
            "noNonNullAssertion": "warn"
          },
          "suspicious": {
            "noExplicitAny": "warn"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "warn",
              "options": {
                "maxAllowedComplexity": 10
              }
            },
            "noExcessiveLinesPerFunction": {
              "level": "warn",
              "options": {
                "maxLines": 40
              }
            }
          }
        }
      }
    },
    {
      "includes": ["examples/quick-start/node.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          }
        }
      }
    },
    {
      "includes": ["examples/quick-start/browser.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": "off"
          }
        }
      }
    }
  ]
}
