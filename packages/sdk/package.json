{
  "name": "@laminapdf/sdk",
  "version": "0.2.0-alpha.2",
  "description": "Create, read, edit and save PDFs from TypeScript: Lamina PDF's Rust core as WebAssembly, synchronous after init(), in browsers, Node, Deno, Bun and Cloudflare Workers.",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://laminapdf.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laudebugs/laminapdf.git",
    "directory": "packages/sdk"
  },
  "keywords": [
    "pdf",
    "pdf-generation",
    "pdf-editing",
    "wasm",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "docs",
    "schemas"
  ],
  "exports": {
    ".": {
      "workerd": {
        "types": "./dist/entry/workerd.d.ts",
        "default": "./dist/entry/workerd.js"
      },
      "deno": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "browser": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "node": {
        "types": "./dist/entry/node.d.ts",
        "default": "./dist/entry/node.js"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./explain": {
      "types": "./dist/explain.d.ts",
      "default": "./dist/explain.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "default": "./dist/worker/index.js"
    },
    "./worker/server": {
      "types": "./dist/worker/server.d.ts",
      "default": "./dist/worker/server.js"
    },
    "./schemas/error.schema.json": "./schemas/error.schema.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepack": "node ../../apps/docs/scripts/package-docs.mjs docs --api",
    "build:wasm": "tsc -p tsconfig.build.json",
    "typecheck:wasm": "tsc --noEmit -p tsconfig.json",
    "test:wasm": "pnpm run build:wasm && tsc --noEmit -p tsconfig.json && vitest run -c vitest.node.config.ts --project node --project small-memory",
    "lint:package": "publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@laminapdf/wasm": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@laminapdf/test-utils": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "ajv": "catalog:",
    "bun": "catalog:",
    "deno": "catalog:",
    "esbuild": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
