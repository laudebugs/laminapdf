          "minimum": 0,
          "type": "integer"
        },
        "pageIndex": {
          "description": "0-based page index (ADR 0027 §6).",
          "minimum": 0,
          "type": "integer"
        },
        "streamOffset": {
          "description": "Byte offset in the decoded data of `object`.",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
