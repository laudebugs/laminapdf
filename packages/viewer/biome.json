{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "root": false,
  "extends": "//",
  "overrides": [
    {
      "includes": ["src/**", "test/**", "examples/**", "demo/**", "perf/page/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "error"
          },
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Buffer": "Node-only: use Uint8Array.",
                  "process": "Node-only: pass configuration in from the caller."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["examples/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../**", "**/src/**", "**/test/**", "**/fixtures/**"],
                    "message": "Examples import only public entry points (@laminapdf/viewer, @laminapdf/sdk, @laminapdf/render), never another folder of the repository: docs/guidelines/examples.md."
                  }
                ]
              }
            },
            "noNonNullAssertion": "error"
          },
          "suspicious": {
            "noExplicitAny": "error"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 10
              }
            },
            "noExcessiveLinesPerFunction": {
              "level": "error",
              "options": {
                "maxLines": 40
              }
            }
          }
        }
      }
    }
  ]
}
