{
  "name": "@laminapdf/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Lamina PDF's Paper components for React 19: buttons, toggles, the mode switcher, tabs and form controls, built on React Aria Components and styled only with @laminapdf/tokens. Workspace-only for now.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./src/styles/index.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json && tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.build.json && vitest run -c vitest.node.config.ts",
    "demo": "vite --config vite.demo.config.ts",
    "demo:build": "vite build --config vite.demo.config.ts"
  },
  "dependencies": {
    "@laminapdf/icons": "workspace:*",
    "@laminapdf/tokens": "workspace:*",
    "react-aria-components": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@laminapdf/test-utils": "workspace:*",
    "@rolldown/plugin-babel": "catalog:",
    "@types/babel__core": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "axe-core": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
