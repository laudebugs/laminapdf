{
  "name": "@lamina/pdf",
  "version": "0.0.0",
  "private": true,
  "description": "Create, read, edit and save PDFs from TypeScript: lamina's Rust core as WebAssembly, synchronous after init(), in browsers, Node, Deno, Bun and Cloudflare Workers.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "workerd": {
        "types": "./dist/entry/workerd.d.ts",
        "default": "./dist/entry/workerd.js"
      },
      "deno": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "browser": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "node": {
        "types": "./dist/entry/node.d.ts",
        "default": "./dist/entry/node.js"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:wasm": "tsc -p tsconfig.build.json",
    "typecheck:wasm": "tsc --noEmit -p tsconfig.json",
    "test:wasm": "pnpm run build:wasm && tsc --noEmit -p tsconfig.json && vitest run -c vitest.node.config.ts",
    "lint:package": "publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@lamina/wasm": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "bun": "catalog:",
    "deno": "catalog:",
    "esbuild": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
