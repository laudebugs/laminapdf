{
  "name": "@laminapdf/wasm",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "lamina's WebAssembly modules and their wasm-bindgen glue: lamina_base (open, read, edit, save, vector and image pages), lamina_text (all of base plus fonts and text) and lamina_extract (all of base plus text extraction); and lamina_render_hayro, lamina-render's hayro adapter, which @laminapdf/render-hayro wraps. Generated into dist/ by `cargo xtask wasm`; @laminapdf/pdf is the API to use.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./base": {
      "types": "./dist/lamina_base.d.ts",
      "default": "./dist/lamina_base.js"
    },
    "./text": {
      "types": "./dist/lamina_text.d.ts",
      "default": "./dist/lamina_text.js"
    },
    "./extract": {
      "types": "./dist/lamina_extract.d.ts",
      "default": "./dist/lamina_extract.js"
    },
    "./render-hayro": {
      "types": "./dist/lamina_render_hayro.d.ts",
      "default": "./dist/lamina_render_hayro.js"
    },
    "./lamina_base.wasm": "./dist/lamina_base.wasm",
    "./lamina_text.wasm": "./dist/lamina_text.wasm",
    "./lamina_extract.wasm": "./dist/lamina_extract.wasm",
    "./lamina_render_hayro.wasm": "./dist/lamina_render_hayro.wasm",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck:wasm": "tsc --noEmit -p tsconfig.json",
    "test:wasm": "tsc --noEmit -p tsconfig.json && vitest run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
