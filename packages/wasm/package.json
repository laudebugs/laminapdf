{
  "name": "@laminapdf/wasm",
  "version": "0.2.0-alpha.2",
  "description": "Lamina PDF's WebAssembly modules and their wasm-bindgen glue: lamina_pdf_base (open, read, edit, save, vector and image pages), lamina_pdf_text (all of base plus fonts and text) and lamina_pdf_extract (all of base plus text extraction); and lamina_pdf_render_hayro, laminapdf-render's hayro adapter, which @laminapdf/render-hayro wraps. Generated into dist/ by `cargo xtask wasm`; @laminapdf/sdk is the API to use.",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://laminapdf.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laudebugs/laminapdf.git",
    "directory": "packages/wasm"
  },
  "keywords": [
    "pdf",
    "wasm",
    "webassembly"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./base": {
      "types": "./dist/lamina_pdf_base.d.ts",
      "default": "./dist/lamina_pdf_base.js"
    },
    "./text": {
      "types": "./dist/lamina_pdf_text.d.ts",
      "default": "./dist/lamina_pdf_text.js"
    },
    "./extract": {
      "types": "./dist/lamina_pdf_extract.d.ts",
      "default": "./dist/lamina_pdf_extract.js"
    },
    "./render-hayro": {
      "types": "./dist/lamina_pdf_render_hayro.d.ts",
      "default": "./dist/lamina_pdf_render_hayro.js"
    },
    "./lamina_pdf_base.wasm": "./dist/lamina_pdf_base.wasm",
    "./lamina_pdf_text.wasm": "./dist/lamina_pdf_text.wasm",
    "./lamina_pdf_extract.wasm": "./dist/lamina_pdf_extract.wasm",
    "./lamina_pdf_render_hayro.wasm": "./dist/lamina_pdf_render_hayro.wasm",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck:wasm": "tsc --noEmit -p tsconfig.json",
    "test:wasm": "tsc --noEmit -p tsconfig.json && vitest run"
  },
  "devDependencies": {
    "@laminapdf/test-utils": "workspace:*",
    "@types/node": "catalog:",
    "ajv": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
