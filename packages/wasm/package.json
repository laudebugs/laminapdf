{
  "name": "@laminapdf/wasm",
  "version": "0.4.0",
  "description": "The WebAssembly build of Lamina PDF's Rust core, which @laminapdf/sdk runs on: create, read, edit and save PDFs and extract their text. Use @laminapdf/sdk; this package holds its compiled modules.",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://laminapdf.com",
  "bugs": {
    "url": "https://github.com/laudebugs/laminapdf/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laudebugs/laminapdf.git",
    "directory": "packages/wasm"
  },
  "keywords": [
    "pdf",
    "wasm",
    "webassembly",
    "pdf-generation",
    "pdf-editing",
    "text-extraction"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./base": {
      "types": "./dist/lamina_pdf_base.d.ts",
      "default": "./dist/lamina_pdf_base.js"
    },
    "./text": {
      "types": "./dist/lamina_pdf_text.d.ts",
      "default": "./dist/lamina_pdf_text.js"
    },
    "./extract": {
      "types": "./dist/lamina_pdf_extract.d.ts",
      "default": "./dist/lamina_pdf_extract.js"
    },
    "./render-hayro": {
      "types": "./dist/lamina_pdf_render_hayro.d.ts",
      "default": "./dist/lamina_pdf_render_hayro.js"
    },
    "./tiff": {
      "types": "./dist/lamina_pdf_tiff.d.ts",
      "default": "./dist/lamina_pdf_tiff.js"
    },
    "./lamina_pdf_base.wasm": "./dist/lamina_pdf_base.wasm",
    "./lamina_pdf_text.wasm": "./dist/lamina_pdf_text.wasm",
    "./lamina_pdf_extract.wasm": "./dist/lamina_pdf_extract.wasm",
    "./lamina_pdf_render_hayro.wasm": "./dist/lamina_pdf_render_hayro.wasm",
    "./lamina_pdf_tiff.wasm": "./dist/lamina_pdf_tiff.wasm",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck:wasm": "tsc --noEmit -p tsconfig.json",
    "test:wasm": "tsc --noEmit -p tsconfig.json && vitest run"
  },
  "devDependencies": {
    "@laminapdf/test-utils": "workspace:*",
    "@types/node": "catalog:",
    "ajv": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
