{
  "$defs": {
    "AlignSpec": {
      "description": "Where a line's text sits.",
      "oneOf": [
        {
          "const": "start",
          "description": "The start side (left in left-to-right text).",
          "type": "string"
        },
        {
          "const": "end",
          "description": "The end side.",
          "type": "string"
        },
        {
          "const": "left",
          "description": "Flush left.",
          "type": "string"
        },
        {
          "const": "right",
          "description": "Flush right.",
          "type": "string"
        },
        {
          "const": "center",
          "description": "Centred.",
          "type": "string"
        }
      ]
    },
    "BlockSpec": {
      "description": "One block of the flow, tagged by `type`.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A paragraph.",
          "properties": {
            "align": {
              "anyOf": [
                {
                  "$ref": "#/$defs/AlignSpec"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Where the lines sit."
            },
            "breakBefore": {
              "description": "Start it on a new page.",
              "type": "boolean"
            },
            "keepWithNext": {
              "description": "Keep it on the page of the next block.",
              "type": "boolean"
            },
            "level": {
              "description": "The heading's level, 1 to 6: needed by a heading, refused on a paragraph.",
              "format": "uint8",
              "maximum": 6,
              "minimum": 1,
              "type": [
                "integer",
                "null"
              ]
            },
            "lineHeight": {
              "description": "The space between lines, as a factor of the size (1.2 when left out).",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "orphans": {
              "description": "The fewest lines of the paragraph left at the foot of a page before it breaks (2 when\nleft out).",
              "format": "uint",
              "minimum": 1,
              "type": [
                "integer",
                "null"
              ]
            },
            "spaceAfter": {
              "description": "Points of space below.",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "spaceBefore": {
              "description": "Points of space above.",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "spans": {
              "description": "The text as spans; give this or `text`.",
              "items": {
                "$ref": "#/$defs/SpanSpec"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "style": {
              "description": "The style of `text`, and of spans that name none (`body` when left out).",
              "type": [
                "string",
                "null"
              ]
            },
            "text": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Text"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The text, in `style`; give this or `spans`."
            },
            "type": {
              "const": "paragraph",
              "type": "string"
            },
            "widows": {
              "description": "The fewest lines of the paragraph carried to the top of a new page (2 when left out).",
              "format": "uint",
              "minimum": 1,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A heading of `level` 1 to 6, in the outline and kept with the next block.",
          "properties": {
            "align": {
              "anyOf": [
                {
                  "$ref": "#/$defs/AlignSpec"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Where the lines sit."
            },
            "breakBefore": {
              "description": "Start it on a new page.",
              "type": "boolean"
            },
            "keepWithNext": {
              "description": "Keep it on the page of the next block.",
              "type": "boolean"
            },
            "level": {
              "description": "The heading's level, 1 to 6: needed by a heading, refused on a paragraph.",
              "format": "uint8",
              "maximum": 6,
              "minimum": 1,
              "type": [
                "integer",
                "null"
              ]
            },
            "lineHeight": {
              "description": "The space between lines, as a factor of the size (1.2 when left out).",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "orphans": {
              "description": "The fewest lines of the paragraph left at the foot of a page before it breaks (2 when\nleft out).",
              "format": "uint",
              "minimum": 1,
              "type": [
                "integer",
                "null"
              ]
            },
            "spaceAfter": {
              "description": "Points of space below.",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "spaceBefore": {
              "description": "Points of space above.",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "spans": {
              "description": "The text as spans; give this or `text`.",
              "items": {
                "$ref": "#/$defs/SpanSpec"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "style": {
              "description": "The style of `text`, and of spans that name none (`body` when left out).",
              "type": [
                "string",
                "null"
              ]
            },
            "text": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Text"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The text, in `style`; give this or `spans`."
            },
            "type": {
              "const": "heading",
              "type": "string"
            },
            "widows": {
              "description": "The fewest lines of the paragraph carried to the top of a new page (2 when left out).",
              "format": "uint",
              "minimum": 1,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A bulleted or numbered list.",
          "properties": {
            "indent": {
              "description": "Points the items are indented.",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "items": {
              "description": "The items.",
              "items": {
                "$ref": "#/$defs/ListItemSpec"
              },
              "type": "array"
            },
            "kind": {
              "$ref": "#/$defs/ListKindSpec",
              "description": "`bullet` or `numbered`."
            },
            "start": {
              "description": "The first number of a numbered list (1 when left out).",
              "format": "uint",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "style": {
              "description": "The markers' style (`body` when left out).",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "list",
              "type": "string"
            }
          },
          "required": [
            "type",
            "kind",
            "items"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "An image, with its alternate text.",
          "properties": {
            "alt": {
              "$ref": "#/$defs/Text",
              "description": "Its alternate text, which a screen reader reads."
            },
            "image": {
              "description": "An image given beside the document, by name.",
              "type": "string"
            },
            "type": {
              "const": "figure",
              "type": "string"
            },
            "width": {
              "description": "Its width in points (the body's width at most; its own size when left out).",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "image",
            "alt"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Empty space.",
          "properties": {
            "height": {
              "description": "Its height in points.",
              "format": "double",
              "minimum": 0,
              "type": "number"
            },
            "type": {
              "const": "spacer",
              "type": "string"
            }
          },
          "required": [
            "type",
            "height"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The next block starts a page.",
          "properties": {
            "type": {
              "const": "pageBreak",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Blocks kept on one page.",
          "properties": {
            "blocks": {
              "description": "The blocks.",
              "items": {
                "$ref": "#/$defs/BlockSpec"
              },
              "type": "array"
            },
            "type": {
              "const": "keep",
              "type": "string"
            }
          },
          "required": [
            "type",
            "blocks"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A table whose header row repeats on each page it runs onto.",
          "properties": {
            "columns": {
              "description": "One width per column.",
              "items": {
                "$ref": "#/$defs/ColumnSpec"
              },
              "type": "array"
            },
            "footer": {
              "description": "The footer rows, kept with the last body row.",
              "items": {
                "$ref": "#/$defs/RowSpec"
              },
              "type": "array"
            },
            "frame": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RuleSpec"
                },
                {
                  "type": "null"
                }
              ],
              "description": "A rule around the table."
            },
            "header": {
              "description": "The header rows, repeated on each page the table runs onto.",
              "items": {
                "$ref": "#/$defs/RowSpec"
              },
              "type": "array"
            },
            "headerBackground": {
              "description": "The header rows' background, as `#rrggbb`.",
              "type": [
                "string",
                "null"
              ]
            },
            "headerRule": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RuleSpec"
                },
                {
                  "type": "null"
                }
              ],
              "description": "A rule under the header."
            },
            "padding": {
              "description": "Points of space inside each cell.",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "rowRules": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RuleSpec"
                },
                {
                  "type": "null"
                }
              ],
              "description": "A rule between body rows."
            },
            "rows": {
              "description": "The body rows; a row is never split between pages.",
              "items": {
                "$ref": "#/$defs/RowSpec"
              },
              "type": "array"
            },
            "spaceAfter": {
              "description": "Points of space below the table.",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "spaceBefore": {
              "description": "Points of space above the table.",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "type": {
              "const": "table",
              "type": "string"
            }
          },
          "required": [
            "type",
            "columns"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A contents page: the headings and the pages they start on.",
          "properties": {
            "indent": {
              "description": "Points each level below the first is indented.",
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "levels": {
              "description": "The deepest heading level it lists, 1 to 6 (2 when left out).",
              "format": "uint8",
              "maximum": 6,
              "minimum": 1,
              "type": [
                "integer",
                "null"
              ]
            },
            "style": {
              "description": "The entries' style (`body` when left out).",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "const": "contents",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A block quotation.",
          "properties": {
            "blocks": {
              "description": "The blocks.",
              "items": {
                "$ref": "#/$defs/BlockSpec"
              },
              "type": "array"
            },
            "type": {
              "const": "quote",
              "type": "string"
            }
          },
          "required": [
            "type",
            "blocks"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Code, line by line as written.",
          "properties": {
            "style": {
              "description": "Its style (`body` when left out).",
              "type": [
                "string",
                "null"
              ]
            },
            "text": {
              "$ref": "#/$defs/Text",
              "description": "The code."
            },
            "type": {
              "const": "codeBlock",
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A horizontal rule.",
          "properties": {
            "type": {
              "const": "rule",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "CellSpec": {
      "additionalProperties": false,
      "description": "A table cell.",
      "properties": {
        "align": {
          "anyOf": [
            {
              "$ref": "#/$defs/AlignSpec"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where its lines sit."
        },
        "span": {
          "description": "How many columns it spans (1 when left out).",
          "format": "uint32",
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "spans": {
          "description": "The text as spans.",
          "items": {
            "$ref": "#/$defs/SpanSpec"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "style": {
          "description": "The text's style (`body` when left out).",
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The text; give this or `spans` (an empty cell has neither)."
        },
        "valign": {
          "anyOf": [
            {
              "$ref": "#/$defs/VAlignSpec"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where its text sits in a row taller than it: `top` (the default), `middle` or `bottom`."
        }
      },
      "type": "object"
    },
    "ColumnSpec": {
      "description": "A column's width.",
      "oneOf": [
        {
          "const": "auto",
          "description": "As wide as its widest cell needs, if the table fits.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "A width in points: `{ \"fixed\": 80 }`.",
          "properties": {
            "fixed": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "fixed"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A share of the room the other columns leave: `{ \"fraction\": 1 }`.",
          "properties": {
            "fraction": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "fraction"
          ],
          "type": "object"
        }
      ]
    },
    "ListItemSpec": {
      "additionalProperties": false,
      "description": "A list item: a paragraph, and a list nested under it.",
      "properties": {
        "list": {
          "anyOf": [
            {
              "$ref": "#/$defs/ListSpec"
            },
            {
              "type": "null"
            }
          ],
          "description": "A list nested under the item."
        },
        "marker": {
          "description": "A marker of its own, such as `☑`.",
          "type": [
            "string",
            "null"
          ]
        },
        "spans": {
          "description": "The text as spans.",
          "items": {
            "$ref": "#/$defs/SpanSpec"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "style": {
          "description": "The text's style (`body` when left out).",
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The text; give this or `spans`."
        }
      },
      "type": "object"
    },
    "ListKindSpec": {
      "description": "A list's kind.",
      "oneOf": [
        {
          "const": "bullet",
          "description": "Bullets.",
          "type": "string"
        },
        {
          "const": "numbered",
          "description": "Numbers.",
          "type": "string"
        }
      ]
    },
    "ListSpec": {
      "additionalProperties": false,
      "description": "A list.",
      "properties": {
        "indent": {
          "description": "Points the items are indented.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "items": {
          "description": "The items.",
          "items": {
            "$ref": "#/$defs/ListItemSpec"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/ListKindSpec",
          "description": "`bullet` or `numbered`."
        },
        "start": {
          "description": "The first number of a numbered list (1 when left out).",
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "style": {
          "description": "The markers' style (`body` when left out).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "items"
      ],
      "type": "object"
    },
    "MarginsSpec": {
      "anyOf": [
        {
          "description": "The same on all four sides.",
          "format": "double",
          "type": "number"
        },
        {
          "description": "`[top, right, bottom, left]`.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array"
        }
      ],
      "description": "Margins."
    },
    "PageSizeSpec": {
      "anyOf": [
        {
          "description": "`A0` to `A6`, `Letter`, `Legal` or `Tabloid`.",
          "type": "string"
        },
        {
          "description": "`[width, height]` in points.",
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      ],
      "description": "A page size."
    },
    "PageSpec": {
      "additionalProperties": false,
      "description": "The pages a document flows through.",
      "properties": {
        "first": {
          "anyOf": [
            {
              "$ref": "#/$defs/PageSpec"
            },
            {
              "type": "null"
            }
          ],
          "description": "Different settings for the first page, such as no header."
        },
        "footer": {
          "anyOf": [
            {
              "$ref": "#/$defs/RegionSpec"
            },
            {
              "type": "null"
            }
          ],
          "description": "The footer."
        },
        "header": {
          "anyOf": [
            {
              "$ref": "#/$defs/RegionSpec"
            },
            {
              "type": "null"
            }
          ],
          "description": "The header: text at its start, centre and end."
        },
        "margins": {
          "anyOf": [
            {
              "$ref": "#/$defs/MarginsSpec"
            },
            {
              "type": "null"
            }
          ],
          "description": "The margins: one number for all four, or `[top, right, bottom, left]` (72 points when left out)."
        },
        "size": {
          "$ref": "#/$defs/PageSizeSpec",
          "description": "A size name (`A4`, `A5`, `Letter`, `Legal`, …) or `[width, height]` in points."
        },
        "style": {
          "description": "The header and footer's style (`body` when left out).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "size"
      ],
      "type": "object"
    },
    "ParagraphSpec": {
      "additionalProperties": false,
      "description": "A paragraph or a heading: its text as one string, or as spans of different styles.",
      "properties": {
        "align": {
          "anyOf": [
            {
              "$ref": "#/$defs/AlignSpec"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where the lines sit."
        },
        "breakBefore": {
          "description": "Start it on a new page.",
          "type": "boolean"
        },
        "keepWithNext": {
          "description": "Keep it on the page of the next block.",
          "type": "boolean"
        },
        "level": {
          "description": "The heading's level, 1 to 6: needed by a heading, refused on a paragraph.",
          "format": "uint8",
          "maximum": 6,
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "lineHeight": {
          "description": "The space between lines, as a factor of the size (1.2 when left out).",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "orphans": {
          "description": "The fewest lines of the paragraph left at the foot of a page before it breaks (2 when\nleft out).",
          "format": "uint",
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "spaceAfter": {
          "description": "Points of space below.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "spaceBefore": {
          "description": "Points of space above.",
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "spans": {
          "description": "The text as spans; give this or `text`.",
          "items": {
            "$ref": "#/$defs/SpanSpec"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "style": {
          "description": "The style of `text`, and of spans that name none (`body` when left out).",
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "anyOf": [
            {
              "$ref": "#/$defs/Text"
            },
            {
              "type": "null"
            }
          ],
          "description": "The text, in `style`; give this or `spans`."
        },
        "widows": {
          "description": "The fewest lines of the paragraph carried to the top of a new page (2 when left out).",
          "format": "uint",
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ProfileName": {
      "description": "A conformance profile, by its usual name.",
      "oneOf": [
        {
          "const": "PDF/UA-1",
          "description": "PDF/UA-1 (ISO 14289-1).",
