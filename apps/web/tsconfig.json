{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "e2e/**/*.ts",
    "test/**/*.ts",
    "plugins/**/*.ts",
    "scripts/**/*.ts",
    "vite.config.ts",
    "vitest.*.config.ts"
  ],
  "exclude": ["src/sw/**"]
}
