// The reader's Workers (ADR 0011 §1): static assets from Vite's dist/, no Worker code, so every
// request is answered by the asset server and nothing can be uploaded. Unknown paths get
// index.html (the app's own routes). The headers are public/_headers. Deployed by
// .github/workflows/web-deploy.yml (todo C4d; apps/web/DEPLOY.md): production at
// app.laminapdf.com from `web-v*` tags only, staging at staging-app.laminapdf.com ([env.staging]
// below) from every push to main, and a preview version per pull request on this Worker
// (`wrangler versions upload --preview-alias pr-<n>`), which doesn't deploy it.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lamina-pdf-web",
  "compatibility_date": "2026-10-01",
  // A Workers custom domain on the laminapdf.com zone: `wrangler deploy` creates its DNS record and
  // certificate. The deploy token needs Zone → Workers Routes → Edit on that zone.
  "routes": [{ "pattern": "app.laminapdf.com", "custom_domain": true }],
  // One address per deploy: no workers.dev copy of production. The per-PR preview URLs stay on.
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // No Worker code runs, so there are no Worker logs to keep (ADR 0011 §5).
  "observability": { "enabled": false },
  "env": {
    // Staging: main's reader, as the Worker lamina-pdf-web-staging. Each key is set here, not
    // inherited, so the two Workers can't drift into sharing a route.
    "staging": {
      "name": "lamina-pdf-web-staging",
      "routes": [{ "pattern": "staging-app.laminapdf.com", "custom_domain": true }],
      // No previews here: they stay on the production Worker.
      "workers_dev": false,
      "preview_urls": false,
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application"
      },
      "observability": { "enabled": false }
    }
  }
}
