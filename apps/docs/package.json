{
  "name": "@laminapdf/docs",
  "version": "0.0.0",
  "private": true,
  "description": "Lamina PDF's documentation site (Astro + Starlight): quick starts, guides, the @laminapdf/sdk API reference (TypeDoc) and the examples, deployed to Cloudflare Workers static assets.",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/build-runner.mjs && ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "node scripts/build-runner.mjs && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 LAMINA_PDF_DOCS_TYPEDOC=0 astro sync && tsc --noEmit",
    "test": "node --test plugins/*.test.mjs scripts/*.test.mjs runner/*.test.mjs test/*.test.mjs",
    "check:api-docs": "node scripts/check-api-docs.mjs",
    "test:browser": "vitest run -c vitest.browser.config.ts",
    "build:runner": "node scripts/build-runner.mjs",
    "e2e": "vitest run -c vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@astrojs/starlight": "0.42.8",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@expressive-code/core": "0.44.3",
    "@laminapdf/fonts": "workspace:*",
    "@laminapdf/icons": "workspace:*",
    "@laminapdf/render": "workspace:*",
    "@laminapdf/render-hayro": "workspace:*",
    "@laminapdf/sdk": "workspace:*",
    "@laminapdf/site-kit": "workspace:*",
    "@laminapdf/test-utils": "workspace:*",
    "@laminapdf/tokens": "workspace:*",
    "@lezer/highlight": "1.2.5",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "astro": "7.4.5",
    "axe-core": "catalog:",
    "codemirror": "6.0.2",
    "playwright": "catalog:",
    "prettier": "3.9.10",
    "source-code-pro": "2.42.0",
    "source-sans": "3.52.0",
    "starlight-links-validator": "0.27.0",
    "starlight-typedoc": "0.23.2",
    "sucrase": "3.35.1",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.1",
    "typescript": "catalog:typedoc",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
