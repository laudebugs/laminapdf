# Response headers for every file of the docs site (Workers static assets): ADR 0011 §4's, with
# the differences a static docs site needs. `script-src` lists the hash of each inline script
# the build wrote (astro.config.mjs replaces the placeholder in dist/_headers);
# `style-src` is 'self' alone, since the build moves every style attribute into a style sheet
# (@laminapdf/site-kit's inlineStylesToClasses); and `connect-src` is only 'self' (search
# fetches its own index; nothing remote).
# Every build but the released docs' (LAMINA_PDF_ENV=production) also sends `X-Robots-Tag: noindex`,
# which @laminapdf/site-kit's previewNoindex adds after the build.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval' 'inline-script-hashes'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-src 'self'; frame-ancestors 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; upgrade-insecure-requests
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), bluetooth=(), browsing-topics=(), clipboard-read=(), clipboard-write=(self)
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Cross-Origin-Resource-Policy: same-origin

# Astro's bundled assets are content-hashed.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The example PDFs open in the browser's own PDF viewer, which a page CSP can block.
/examples/pdf/*
  ! Content-Security-Policy

# The example runner (scripts/build-runner.mjs): the module worker that runs a reader's edit of an
# example. It needs 'unsafe-eval' to run that code, so it gets its own policy, and nothing else on
# the site does. A worker's CSP comes from its own script's response, so the pages that start it
# keep the policy above. Only same-origin files: the SDK and hayro's WebAssembly and the inputs.
/run/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval'; connect-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'

# The runner's WebAssembly and inputs: content-hashed by its build, like /_astro/.
/run/assets/*
  Cache-Control: public, max-age=31536000, immutable
