---
// An example's code: both languages in the site's TypeScript and Rust tabs (which remember the
// reader's choice across pages), or the one file alone.
import { TabItem, Tabs } from "@astrojs/starlight/components";
import Snippet from "./Snippet.astro";

interface Props {
  /** The TypeScript file, from the repository root. */
  readonly ts?: string;
  /** The Rust file, from the repository root. */
  readonly rust?: string;
}

const { ts, rust } = Astro.props;
const only = ts ?? rust;
---

{
  ts !== undefined && rust !== undefined ? (
    <Tabs syncKey="lang">
      <TabItem label="TypeScript">
        <Snippet file={ts} />
      </TabItem>
      <TabItem label="Rust">
        <Snippet file={rust} />
      </TabItem>
    </Tabs>
  ) : (
    only !== undefined && <Snippet file={only} />
  )
}
