---
// An example in its languages, with what it makes: TypeScript and Rust in one row of tabs, and,
// for an example that builds a PDF, a picture of its first page with a link to the PDF, beside the
// code on wide screens and below it on narrow ones, with no click and no script (todo Q4d). A
// Result tab shows every page when there is more than that first one; an example that reads a PDF
// has an Output tab with the text it prints instead. The pictures and the manifest come from
// `cargo xtask docs-previews`, which renders the example goldens; `cargo xtask check docs` keeps them
// in step. The examples in runner/examples.ts also get "Edit and run" under the picture (todo
// B7e), when the runner was built (scripts/build-runner.mjs); it loads nothing until it is pressed.
// Where the page is beside the code, a divider between them sets the page's width for every example
// (todo Q4q); it is shown only once its script runs.
import { existsSync } from "node:fs";
import { TabItem, Tabs } from "@astrojs/starlight/components";
// @laminapdf/icons' own files, inlined at build time.
import downloadIcon from "@laminapdf/icons/svg/download.svg?raw";
import playIcon from "@laminapdf/icons/svg/play.svg?raw";
import resetIcon from "@laminapdf/icons/svg/reset.svg?raw";
import { decorativeIcon } from "@laminapdf/site-kit/icon";
import manifest from "../../public/examples/preview/manifest.json";
import { RUNNABLE } from "../../runner/examples.ts";
import Snippet from "./Snippet.astro";

interface Props {
  /** The TypeScript file, from the repository root (as `Snippet` takes it). */
  readonly ts?: string;
  /** The Rust file, from the repository root. */
  readonly rust?: string;
  /** The example goldens it makes, by file stem (`hello`, or both `pdf_a_archive-2b` and `-2u`). */
  readonly result?: string | readonly string[];
  /** A text file it prints, from the repository root, shown in an Output tab. */
  readonly output?: string;
}

// The outputs a page may show: the reading examples' goldens, which their tests check.
const OUTPUTS: Record<string, string> = import.meta.glob(
  ["../../../../fixtures/extract/examples/*.{md,txt}", "../../../../fixtures/reveal/examples/*.txt"],
  { query: "?raw", import: "default", eager: true },
);

// The TypeScript examples, for the editor's first text: the file as the Code tab shows it.
const SOURCES: Record<string, string> = import.meta.glob(
  ["../../../../packages/sdk/examples/*.ts", "../../../../packages/sdk/examples/quick-start/*.ts"],
  { query: "?raw", import: "default", eager: true },
);
/** Whether the runner was built: the docs build runs scripts/build-runner.mjs first, from apps/docs. */
const RUNNER = existsSync("public/run/worker.js");

const { ts, rust, result, output } = Astro.props;
const source = ts !== undefined && RUNNER && RUNNABLE[ts] !== undefined ? SOURCES[`../../../../${ts}`] : undefined;
const examples = result === undefined ? [] : typeof result === "string" ? [result] : result;
const pictures = examples.map((stem) => {
  const entry = (manifest.examples as Record<string, (typeof manifest.examples)["hello"] | undefined>)[stem];
  if (entry === undefined) {
    throw new Error(`Example: ${stem} has no pictures; run \`cargo xtask docs-previews\``);
  }
  return { stem, ...entry };
});
const text = output === undefined ? undefined : OUTPUTS[`../../../../${output}`];
if (output !== undefined && text === undefined) {
  throw new Error(`Example: ${output} is not one of the outputs apps/docs may show`);
}
/** The first page of the first PDF, shown beside the code. */
const first = pictures[0];
/** Whether the Result tab has more to show than that first page. */
const more = pictures.length > 1 || (first !== undefined && first.pages.length > 1);
/** Tabs for two languages, or for the code and what the tabs alone show (every page, the output). */
const tabs = (ts !== undefined && rust !== undefined) || more || text !== undefined;
/** An icon beside a button's label: decorative, so hidden from assistive technology. */
const icon = (svg: string) => decorativeIcon(svg, "run-icon");
const size = (bytes: number) => (bytes < 1024 ? `${bytes} bytes` : `${Math.round(bytes / 1024)} KB`);
const pageCount = (n: number) => (n === 1 ? "1 page" : `${n} pages`);
---

{/* The code, and beside or below it the first page. The code's row shares the site's remembered
     TypeScript or Rust choice (`syncKey`), so a reader who picks Rust sees Rust on every example.
     Only the language is remembered: the script below puts it back when Result or Output is
     picked, so no page opens on its pictures. */}
<div class:list={["example", { "example-with-page": first !== undefined }]}>
  <div class="example-code">
    {
      tabs ? (
        <Tabs syncKey="lang">
          {ts !== undefined && (
            <TabItem label="TypeScript">
              <div class="example-ts">
                <div class="example-source">
                  <Snippet file={ts} />
                </div>
              </div>
            </TabItem>
          )}
          {rust !== undefined && (
            <TabItem label="Rust">
              <Snippet file={rust} />
            </TabItem>
          )}
          {more && (
            <TabItem label="Result">
              {pictures.map((example) => (
                <figure class="example-result">
                  <div class:list={["example-pages", { "example-pages-many": example.pages.length > 1 }]}>
                    {example.pages.map((page, index) => (
                      <img
                        src={`/examples/preview/${example.stem}-${index}.png`}
                        alt={`Page ${index + 1} of ${example.stem}.pdf`}
                        width={Math.round(page.width / 2)}
                        height={Math.round(page.height / 2)}
                        loading="lazy"
                        decoding="async"
                      />
                    ))}
                  </div>
                  <figcaption>
                    <a href={`/examples/pdf/${example.stem}.pdf`}>Open {example.stem}.pdf</a> (
                    {pageCount(example.pages.length)}, {size(example.bytes)})
                  </figcaption>
                </figure>
              ))}
            </TabItem>
          )}
          {text !== undefined && (
            <TabItem label="Output">
              <pre class="example-output">{text}</pre>
            </TabItem>
          )}
        </Tabs>
      ) : ts !== undefined ? (
        <div class="example-ts">
          <div class="example-source">
            <Snippet file={ts} />
          </div>
        </div>
      ) : (
        rust !== undefined && <Snippet file={rust} />
      )
    }
  </div>
  {
    /* The divider between the code and the page (todo Q4q), shown where they sit side by side, once
       its script has run: without it, the page keeps its width. */
    first !== undefined && (
      <lamina-split
        class="example-split"
        role="separator"
        tabindex="0"
        aria-orientation="vertical"
        aria-label="Resize the code and the page"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="50"
        title="Drag to resize; double-click to reset"
      />
    )
  }
  {
    first !== undefined && (
      <div class="example-page not-content">
        <figure class="example-first">
          <img
            src={`/examples/preview/${first.stem}-0.png`}
            alt={`Page 1 of ${first.stem}.pdf`}
            width={Math.round((first.pages[0]?.width ?? 0) / 2)}
            height={Math.round((first.pages[0]?.height ?? 0) / 2)}
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            <a href={`/examples/pdf/${first.stem}.pdf`}>Open {first.stem}.pdf</a> (
            {pageCount(first.pages.length)}, {size(first.bytes)})
          </figcaption>
        </figure>
        {source !== undefined && (
          <lamina-run class="example-run" data-file={ts} data-source={source} data-name={`${first.stem}.pdf`}>
            <button type="button" class="run-open">
              <Fragment set:html={icon(playIcon)} />
              Edit and run
            </button>
            <div class="run-bar" hidden>
              <button type="button" class="run-run">
                <Fragment set:html={icon(playIcon)} />
                Run
              </button>
              <button type="button" class="run-reset">
                <Fragment set:html={icon(resetIcon)} />
                Reset
              </button>
              <button type="button" class="run-download" hidden>
                <Fragment set:html={icon(downloadIcon)} />
                Download PDF
              </button>
            </div>
          </lamina-run>
        )}
      </div>
    )
  }
</div>

<script>
  // Starlight remembers a synced row's last tab in localStorage. Here only TypeScript or Rust may be
  // remembered: after a pick of Result or Output (by click or arrow key), the language goes back.
  const KEY = "starlight-synced-tabs__lang";
  const LANGUAGES = new Set(["TypeScript", "Rust"]);
  const keep = (event: Event) => {
    if (!(event.target instanceof Element) || event.target.closest("starlight-tabs") === null) return;
    // Storage can be blocked (a private window); Starlight then remembers nothing either.
    let before: string | null;
    try {
      before = localStorage.getItem(KEY);
    } catch {
      return;
    }
    // After Starlight's own handler: between listeners of a real event, microtasks run, so a task.
    setTimeout(() => {
      const now = localStorage.getItem(KEY);
      if (now === null || LANGUAGES.has(now)) return;
      if (before !== null && LANGUAGES.has(before)) localStorage.setItem(KEY, before);
      else localStorage.removeItem(KEY);
    }, 0);
  };
  document.addEventListener("click", keep, true);
  document.addEventListener("keydown", keep, true);

  // "Edit and run": the editor and the runner load on the first press, from the docs site only.
  class LaminaRun extends HTMLElement {
    connectedCallback(): void {
      const button = this.querySelector<HTMLButtonElement>(".run-open");
      const bar = this.querySelector<HTMLElement>(".run-bar");
      const run = this.querySelector<HTMLButtonElement>(".run-run");
      const reset = this.querySelector<HTMLButtonElement>(".run-reset");
      const download = this.querySelector<HTMLButtonElement>(".run-download");
      const { file, source, name } = this.dataset;
      if (button === null || bar === null || run === null || reset === null || download === null) return;
      if (file === undefined || source === undefined || name === undefined) return;
      // The TypeScript code, which the editor replaces; the page's own column, where a run's pages
      // take the place of the first page's picture.
      const example = this.closest(".example");
      const code = example?.querySelector<HTMLElement>(".example-ts");
      const shown = code?.querySelector<HTMLElement>(".example-source");
      const picture = example?.querySelector<HTMLElement>(".example-first");
      const side = this.parentElement;
      if (code == null || shown == null || picture == null || side === null) return;
      const open = async () => {
        button.disabled = true;
        button.lastChild?.replaceWith(" Loading the editor…");
        let editor: typeof import("../../runner/editor.ts");
        try {
          editor = await import("../../runner/editor.ts");
        } catch {
          // A deploy may have replaced the editor's file since the page loaded: try again.
          button.lastChild?.replaceWith(" Couldn't load the editor; try again");
          button.disabled = false;
          return;
        }
        button.removeEventListener("click", open);
        button.remove();
        // The bar moves under the editor, so this element is left empty.
        this.hidden = true;
        shown.hidden = true;
        // The editor is TypeScript: a reader on the Rust tab is taken to the TypeScript one.
        const panel = code.closest<HTMLElement>("[role=tabpanel]");
        const tab = panel?.getAttribute("aria-labelledby");
        if (panel?.hidden === true && tab != null) document.getElementById(tab)?.click();
        editor.openRunner({ bar, run, reset, download }, { file, source, name }, { code, picture, pages: side });
      };
      button.addEventListener("click", open);
    }
  }
  customElements.define("lamina-run", LaminaRun);

  // The divider between the code and the page (todo Q4q). The width it sets is one custom property
  // on the root element, so every example on the page follows, and it is kept for the next page in
  // localStorage (a per-reader convenience: without storage, every page opens at the default). It
  // is set through the CSSOM, which the docs' CSP allows; a `style` attribute in markup it blocks.
  const PAGE_KEY = "lamina-docs-example-page";
  const CHOSEN = "--example-page-chosen";
  /** The narrowest page and code the divider allows, in rem (the CSS keeps the same bounds). */
  const MIN_PAGE = 12;
  const MIN_CODE = 20;
  /** How far one arrow key moves the divider, and with Shift, in rem. */
  const STEP = 1;
  const BIG_STEP = 4;
  const root = document.documentElement;
  const remPx = () => Number.parseFloat(getComputedStyle(root).fontSize) || 16;
  const splits = new Set<LaminaSplit>();
  let described = 0;
  /** Updates every divider's value once the frame's changes are in: a drag sets the width on every move. */
  const describeAll = () => {
    if (described !== 0) return;
    described = requestAnimationFrame(() => {
      described = 0;
      for (const split of splits) split.describe();
    });
  };

  /** Sets the page's width, in rem, for every example, or with `undefined` puts back the default. */
  const choose = (rem: number | undefined) => {
    if (rem === undefined) {
      root.style.removeProperty(CHOSEN);
      delete root.dataset.examplePage;
    } else {
      root.style.setProperty(CHOSEN, `${rem}rem`);
      root.dataset.examplePage = "";
    }
    describeAll();
  };
  /** Tells "Edit and run" the page's width has settled, so a run's pages can be drawn again to fit (editor.ts). */
  const settled = () => dispatchEvent(new Event("lamina-example-page-resized"));
  /** Remembers the width, or forgets it; storage may be blocked (a private window), which changes nothing else. */
  const remember = (rem: number | undefined) => {
    try {
      if (rem === undefined) localStorage.removeItem(PAGE_KEY);
      else localStorage.setItem(PAGE_KEY, String(rem));
    } catch {
      // The width then lasts until the page is left.
    }
  };
  try {
    const stored = Number.parseFloat(localStorage.getItem(PAGE_KEY) ?? "");
    if (Number.isFinite(stored) && stored >= MIN_PAGE) choose(stored);
  } catch {
    // No storage: the default width.
  }

  class LaminaSplit extends HTMLElement {
    private example: HTMLElement | null = null;
    private code: HTMLElement | null = null;
    private page: HTMLElement | null = null;
    /** The pointer that moves the divider, while one does. */
    private dragging: number | undefined;

    connectedCallback(): void {
      this.example = this.closest<HTMLElement>(".example");
      this.code = this.example?.querySelector<HTMLElement>(":scope > .example-code") ?? null;
      this.page = this.example?.querySelector<HTMLElement>(":scope > .example-page") ?? null;
      if (this.example === null || this.code === null || this.page === null) return;
      splits.add(this);
      // The two panes it resizes, by ID (aria-controls), numbered in the order the dividers connect.
      const n = splits.size;
      this.code.id ||= `example-code-${n}`;
      this.page.id ||= `example-page-${n}`;
      this.setAttribute("aria-controls", `${this.code.id} ${this.page.id}`);
      this.addEventListener("pointerdown", this.down);
      this.addEventListener("pointermove", this.move);
      this.addEventListener("pointerup", this.up);
      this.addEventListener("pointercancel", this.up);
      // Capture can end without a pointerup (the window loses focus): the drag ends with it.
      this.addEventListener("lostpointercapture", this.up);
      this.addEventListener("keydown", this.key);
      this.addEventListener("dblclick", this.reset);
      this.describe();
    }

    disconnectedCallback(): void {
      splits.delete(this);
    }

    /** The page's width the divider may set here, in rem: from 12rem up to what leaves the code 20rem. */
    private clamp(rem: number): number {
      const example = this.example?.getBoundingClientRect().width ?? 0;
      const most = (example - this.getBoundingClientRect().width) / remPx() - MIN_CODE;
      return Math.round(Math.max(MIN_PAGE, Math.min(rem, most)) * 100) / 100;
    }

    /** The page's width now, in rem. */
    private pageRem(): number {
      return (this.page?.getBoundingClientRect().width ?? 0) / remPx();
    }

    /** The divider's value for assistive technology: the code's share of the two, in percent. */
    describe(): void {
      const code = this.code?.getBoundingClientRect().width ?? 0;
      const page = this.page?.getBoundingClientRect().width ?? 0;
      if (code + page === 0) return;
      const share = Math.round((code / (code + page)) * 100);
      this.setAttribute("aria-valuenow", String(share));
      this.setAttribute("aria-valuetext", `The code takes ${share}% of the width, the page ${100 - share}%`);
    }

    private down = (event: PointerEvent): void => {
      if (event.button !== 0) return;
      // No text selection while it moves, and no focus ring: that is for the keyboard.
      event.preventDefault();
      this.dragging = event.pointerId;
      this.setPointerCapture(event.pointerId);
      root.classList.add("example-resizing");
    };

    private move = (event: PointerEvent): void => {
      if (this.dragging !== event.pointerId) return;
      // Once moved, the example takes all the room (the CSS), so its right edge stays put: the page
      // is what lies right of the pointer, less half the divider.
      if (root.dataset.examplePage === undefined) choose(this.pageRem());
      const right = this.example?.getBoundingClientRect().right ?? 0;
      const half = this.getBoundingClientRect().width / 2;
      choose(this.clamp((right - event.clientX - half) / remPx()));
    };

    private up = (event: PointerEvent): void => {
      if (this.dragging !== event.pointerId) return;
      this.dragging = undefined;
      root.classList.remove("example-resizing");
      if (root.dataset.examplePage !== undefined) remember(this.pageRem());
      settled();
    };

    private key = (event: KeyboardEvent): void => {
      // Alt, Ctrl and Meta with these keys are the browser's own (Alt+← goes back).
      if (event.altKey || event.ctrlKey || event.metaKey) return;
      const step = event.shiftKey ? BIG_STEP : STEP;
      // The divider sits after the code: left gives the page more room, right gives the code more.
      const moves: Record<string, () => number | undefined> = {
        ArrowLeft: () => this.pageRem() + step,
        ArrowRight: () => this.pageRem() - step,
        Home: () => Number.POSITIVE_INFINITY,
        End: () => MIN_PAGE,
        Enter: () => undefined,
      };
      const to = moves[event.key];
      if (to === undefined) return;
      event.preventDefault();
      const rem = to();
      if (rem === undefined) {
        this.reset();
        return;
      }
      if (root.dataset.examplePage === undefined) choose(this.pageRem());
      const chosen = this.clamp(rem);
      choose(chosen);
      remember(chosen);
      settled();
    };

    /** Puts back the page's default width. */
    private reset = (): void => {
      choose(undefined);
      remember(undefined);
      settled();
    };
  }
  customElements.define("lamina-split", LaminaSplit);
  // The window's width changes how much of the two each takes: the value follows.
  addEventListener("resize", describeAll);
</script>

<style>
  /* Narrow screens: the first page below the code, small enough not to push the prose away. */
  .example-with-page {
    --example-page-width: 15rem;

    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--paper-space-24);
  }
  .example-page {
    margin-top: 0;
    width: min(100%, var(--example-page-width));
  }
  /* Wide screens: the page beside the code. The example grows into the margins the content column
     leaves (it stays centred on the column, as the column is in its pane), up to the column's own
     45rem of code plus the page. 90rem (1440 px) is the narrowest viewport where that still leaves
     36rem of code, about 66 characters: the left sidebar, the table of contents, the content's
     padding and a scroll bar's 1rem take the rest. Narrower, the code would wrap or scroll too
     often to read, so the page goes below it. */
  @media (min-width: 90rem) {
    .example-with-page {
      /* The room the example may take: the window less the sidebars, the padding and a scroll bar. */
      --example-room: calc(
        100vw - var(--sl-sidebar-width) - var(--docs-toc-width, 0rem) - 2 * var(--sl-content-pad-x) - 1rem
      );
      /* The divider's width (todo Q4q) sets the page's (--example-page-chosen, on the root element, for
         every example); the code keeps 20rem and the page 12rem whatever was chosen, in this window. */
      --example-page-width: clamp(
        12rem,
        var(--example-page-chosen, 15rem),
        var(--example-room) - 20rem - var(--paper-space-24)
      );
      --example-width: min(var(--example-room), 45rem + var(--paper-space-24) + var(--example-page-width));

      grid-template-columns: minmax(0, 1fr) var(--paper-space-24) var(--example-page-width);
      column-gap: 0;
      width: var(--example-width);
      margin-inline: calc((100% - var(--example-width)) / 2);
    }
    /* Once a reader has moved the divider, the example takes all the room, so the divider stays
       under the pointer as it moves; the page's column has the width they chose. */
    :global(:root[data-example-page]) .example-with-page {
      --example-width: var(--example-room);
    }
    /* Each in its own column: without its script the divider isn't shown, and the page keeps its
       place after the gap. */
    .example-with-page > .example-code {
      grid-column: 1;
    }
    .example-split {
      grid-column: 2;
    }
    .example-with-page > .example-page {
      grid-column: 3;
    }
    .example-page {
      position: sticky;
      top: calc(var(--sl-nav-height) + var(--paper-space-16));
      align-self: start;
      width: auto;
    }
    /* A run's pages can be taller than the window: they scroll with the page. */
    .example-page:has(:global(.run-page)) {
      position: static;
    }
  }
  /* The divider: a hairline in the middle of the gap, which turns to the accent on hover, while
     dragged and when focused, where the whole gap can be grabbed. */
  .example-split {
    display: none;
  }
  @media (min-width: 90rem) {
    .example-split:defined {
      display: block;
      position: relative;
      margin: 0;
      align-self: stretch;
      cursor: col-resize;
      touch-action: none;
    }
  }
  .example-split::before {
    content: "";
    position: absolute;
    inset-block: 0;
    left: 50%;
    width: var(--paper-border-width);
    background: var(--paper-hairline);
    transform: translateX(-50%);
  }
  .example-split:hover::before,
  .example-split:focus-visible::before,
  :global(.example-resizing) .example-split::before {
    width: 3px;
    background: var(--paper-accent);
  }
  /* While the divider moves, the pointer keeps its shape over the code and the page, and no text gets selected. */
  :global(.example-resizing),
  :global(.example-resizing) * {
    cursor: col-resize;
    user-select: none;
  }
  .example-first {
    margin: 0;
  }
  .example-first img,
  .example-pages img,
  .example :global(.run-page) {
    /* Starlight spaces sibling elements in page content; in the grid, the gap does that. */
    display: block;
    margin: 0;
    width: 100%;
    height: auto;
    border: var(--paper-border-width) solid var(--paper-hairline);
    box-shadow: var(--paper-shadow-thumbnail);
  }
  .example-first figcaption,
  .example-result figcaption {
    margin-top: var(--paper-space-8);
    font-size: var(--sl-text-sm);
    color: var(--paper-text-2);
  }
  /* The page's column is outside Starlight's content styles (not-content), so its link is styled here. */
  .example-first a {
    color: var(--paper-accent);
  }
  .example-run {
    display: block;
    margin-top: var(--paper-space-12);
  }
  /* Until its script defines it, and with JavaScript off, the button would do nothing. */
  .example-run[hidden],
  .example-run:not(:defined) {
    display: none;
  }
  .example :global(.run-editor) {
    margin-top: 0;
    border: var(--paper-border-width) solid var(--paper-chip-border);
    max-height: 32rem;
    overflow: auto;
    font-size: var(--sl-text-sm);
  }
  .run-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--paper-space-8);
    align-items: center;
    margin-top: var(--paper-space-8);
  }
  .run-open,
  .run-bar button {
    display: inline-flex;
    align-items: center;
    gap: var(--paper-space-6);
    margin: 0;
    min-height: var(--paper-button-height);
    font: inherit;
    padding: var(--paper-space-4) var(--paper-space-12);
    border: var(--paper-border-width) solid var(--paper-control-border);
    border-radius: var(--paper-radius-4);
    background: var(--paper-raised);
    color: var(--paper-text);
    cursor: pointer;
  }
  .run-bar button[hidden],
  .run-bar[hidden] {
    display: none;
  }
  .example :global(.run-icon) {
    flex: none;
  }
  .run-open:disabled,
  .run-bar button:disabled {
    cursor: progress;
  }
  .example :global(.run-status) {
    margin: var(--paper-space-8) 0 0;
