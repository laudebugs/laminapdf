---
// "Drawing a page" (concepts/drawing-pages): one PDF's bytes read two ways. A render request
// becomes a tile plan, and the renderer (PDFium or hayro) draws RGBA pixels; Lamina PDF's own
// model gives the text, links and selection. The accent follows what the page is about, who owns
// the text: Lamina PDF's model and the path to it. Caption and text description: registry.mjs.
import Arrow from "./kit/Arrow.astro";
import Box from "./kit/Box.astro";
import type { DrawingProps } from "./kit/drawing.ts";
import Lane from "./kit/Lane.astro";
import Markers from "./kit/Markers.astro";
import Svg from "./kit/Svg.astro";

type Props = DrawingProps;
const { prefix, labelledby, describedby } = Astro.props;
const wide = `${prefix}-wide`;
const narrow = `${prefix}-narrow`;
---

<Svg viewBox="0 0 720 292" layout="wide" labelledby={labelledby} describedby={describedby}>
  <Markers prefix={wide} />
  <Box x={0} y={112} w={120} h={60} label="Your PDF" sub="bytes" />
  <Arrow d="M120 142 H138" prefix={wide} head={false} />
  <Arrow d="M138 142 V78 H170" prefix={wide} />
  <Arrow d="M138 142 V218 H170" prefix={wide} focus />

  <Lane x={152} y={16} w={568} h={120} title="Drawing" />
  <Box x={174} y={50} w={140} h={56} label="Render request" sub="page, scale, clip" />
  <Arrow d="M314 78 H330" prefix={wide} />
  <Box x={334} y={50} w={104} h={56} label="Tile plan" sub="pixel size" />
  <Arrow d="M438 78 H454" prefix={wide} />
  <Box x={458} y={50} w={128} h={56} label="Renderer" sub="PDFium or hayro" />
  <Arrow d="M586 78 H602" prefix={wide} />
  <Box x={606} y={50} w={100} h={56} label="RGBA pixels" />

  <Lane x={152} y={156} w={568} h={120} title="Reading" />
  <Box x={174} y={190} w={200} h={56} label="Lamina PDF" sub="its own model" focus />
  <Arrow d="M374 218 H394" prefix={wide} focus />
  <Box x={398} y={190} w={200} h={56} label="Text and links" sub="selection and search" fresh />
</Svg>

<Svg viewBox="0 0 320 400" layout="narrow" labelledby={labelledby} describedby={describedby}>
  <Markers prefix={narrow} />
  <Box x={60} y={0} w={200} h={44} label="Your PDF bytes" />
  <Arrow d="M160 44 V60" prefix={narrow} head={false} />
  <Arrow d="M160 60 H78 V84" prefix={narrow} />
  <Arrow d="M160 60 H242 V84" prefix={narrow} focus />

  <Lane x={0} y={88} w={156} h={312} title="Drawing" />
  <Box x={8} y={124} w={140} h={52} label="Render request" sub="page, scale, clip" />
  <Arrow d="M78 176 V190" prefix={narrow} />
  <Box x={8} y={194} w={140} h={52} label="Tile plan" sub="pixel size" />
  <Arrow d="M78 246 V260" prefix={narrow} />
  <Box x={8} y={264} w={140} h={52} label="Renderer" sub="PDFium or hayro" />
  <Arrow d="M78 316 V330" prefix={narrow} />
  <Box x={8} y={334} w={140} h={52} label="RGBA pixels" />

  <Lane x={164} y={88} w={156} h={172} title="Reading" />
  <Box x={172} y={124} w={140} h={52} label="Lamina PDF" sub="its own model" focus />
  <Arrow d="M242 176 V190" prefix={narrow} focus />
  <Box x={172} y={194} w={140} h={52} label="Text and links" sub="selection, search" fresh />
</Svg>
