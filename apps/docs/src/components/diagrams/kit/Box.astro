---
// A labelled box. `focus` marks the one thing the section is about (the accent, 2 px border);
// `fresh` marks bytes a step writes (the accent, 1.5 px). `sub` is a second, muted line; on the
// accent's tint it uses text-2, since muted falls under 4.5:1 there in the dark theme.
interface Props {
  x: number;
  y: number;
  w: number;
  h: number;
  label: string;
  sub?: string;
  focus?: boolean;
  fresh?: boolean;
}
const { x, y, w, h, label, sub, focus = false, fresh = false } = Astro.props;
const cx = x + w / 2;
const box = focus ? "dg-focus" : fresh ? "dg-fresh" : "dg-box";
---

<rect class={box} x={x} y={y} width={w} height={h} rx="4"></rect>
{
  sub === undefined ? (
    <text class:list={["dg-label", { "dg-focus-label": focus }]} x={cx} y={y + h / 2 + 5} text-anchor="middle">
      {label}
    </text>
  ) : (
    <>
      <text class:list={["dg-label", { "dg-focus-label": focus }]} x={cx} y={y + h / 2 - 3} text-anchor="middle">
        {label}
      </text>
      <text class:list={["dg-sub", { "dg-sub-tint": focus || fresh }]} x={cx} y={y + h / 2 + 16} text-anchor="middle">
        {sub}
      </text>
    </>
  )
}
