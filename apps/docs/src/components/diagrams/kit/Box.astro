---
// A labelled box. `focus` marks the one thing the diagram is about (the accent, a 2 px border);
// `fresh` marks where that thing goes next (the accent's tint, a 1 px border). `sub` is a second, muted line; on the
// accent's tint it uses text-2, since muted falls under 4.5:1 there in the dark theme.
interface Props {
  x: number;
  y: number;
  w: number;
  h: number;
  label: string;
  sub?: string;
  /** A third line under `sub`, for a box that needs two; give the box a height of 76 or more. */
  sub2?: string;
  /** The label is an API name (a mode, an error code): set in mono. */
  mono?: boolean;
  focus?: boolean;
  fresh?: boolean;
}
const { x, y, w, h, label, sub, sub2, mono = false, focus = false, fresh = false } = Astro.props;
// The label's and sub lines' baselines, centred as a block: one line, two, or three.
const [labelY, subY, sub2Y] =
  sub === undefined
    ? [y + h / 2 + 5]
    : sub2 === undefined
      ? [y + h / 2 - 3, y + h / 2 + 16]
      : [y + h / 2 - 12, y + h / 2 + 7, y + h / 2 + 26];
const subClass = ["dg-sub", { "dg-sub-tint": focus || fresh }];
// A sub line may hold API names in backticks, as the registry's text does: they're set in mono.
const parts = (line: string) => {
  const pieces = line.split("`");
  if (pieces.length % 2 === 0) throw new Error(`a backtick is left open in the diagram text "${line}"`);
  return pieces.map((text, i) => ({ text, code: i % 2 === 1 }));
};
const cx = x + w / 2;
const box = focus ? "dg-focus" : fresh ? "dg-fresh" : "dg-box";
---

<rect class={box} x={x} y={y} width={w} height={h} rx="4"></rect>
<text class:list={[mono ? "dg-mono" : "dg-label", { "dg-focus-label": focus }]} x={cx} y={labelY} text-anchor="middle">{label}</text>
{
  sub !== undefined && (
    <text class:list={subClass} x={cx} y={subY} text-anchor="middle">
      {parts(sub).map((p) => (p.code ? <tspan class="dg-mono">{p.text}</tspan> : p.text))}
    </text>
  )
}
{
  sub2 !== undefined && (
    <text class:list={subClass} x={cx} y={sub2Y} text-anchor="middle">
      {parts(sub2).map((p) => (p.code ? <tspan class="dg-mono">{p.text}</tspan> : p.text))}
    </text>
  )
}
