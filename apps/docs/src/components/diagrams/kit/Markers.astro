---
// The arrowheads, defined once per drawing. Their ids start with the drawing's own prefix, so two
// diagrams (or a diagram's two layouts) on one page never share an id.
interface Props {
  prefix: string;
}
const { prefix } = Astro.props;
---

<defs>
  <marker id={`${prefix}-head`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
    <path class="dg-head" d="M0 0 L10 5 L0 10 z"></path>
  </marker>
  <marker id={`${prefix}-head-focus`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
    <path class="dg-head-focus" d="M0 0 L10 5 L0 10 z"></path>
  </marker>
</defs>
