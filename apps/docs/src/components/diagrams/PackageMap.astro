---
// "The published packages" (install, "Every published package"): what each package depends on. In
// JavaScript, @laminapdf/sdk over @laminapdf/wasm and its three modules; @laminapdf/viewer over the
// SDK and @laminapdf/render, which the two renderers implement. In Rust, one crate. Arrows point from
// a package to what it depends on. `focus` takes the accent to the part a page is about
// (PackageMapModules draws it for the three modules). Caption and text description: registry.mjs.
import Arrow from "./kit/Arrow.astro";
import Box from "./kit/Box.astro";
import type { DrawingProps } from "./kit/drawing.ts";
import Lane from "./kit/Lane.astro";
import Markers from "./kit/Markers.astro";
import Strip from "./kit/Strip.astro";
import Svg from "./kit/Svg.astro";

type Props = DrawingProps & { focus?: "sdk" | "modules" | "viewer" };
const { prefix, labelledby, describedby, focus } = Astro.props;
const wide = `${prefix}-wide`;
const narrow = `${prefix}-narrow`;
const modules = (w: number) =>
  ["Base", "Text", "Extract"].map((label, i) => ({
    w: Math.floor(w / 3) + (i === 2 ? w % 3 : 0),
    label,
    focus: focus === "modules",
  }));
---

<Svg viewBox="0 0 720 364" layout="wide" labelledby={labelledby} describedby={describedby}>
  <Markers prefix={wide} />
  <Lane x={0} y={0} w={488} h={364} title="JavaScript" />
  <Box x={16} y={40} w={200} h={52} label="@laminapdf/sdk" sub="the TypeScript API" mono focus={focus === "sdk"} />
  <Arrow d="M116 92 V128" prefix={wide} />
  <Box x={16} y={132} w={200} h={52} label="@laminapdf/wasm" sub="WebAssembly" mono />
  <Strip x={16} y={184} h={44} segments={modules(200)} />

  <Box x={256} y={40} w={216} h={52} label="@laminapdf/viewer" sub="a web PDF viewer" mono focus={focus === "viewer"} />
  <Arrow d="M256 66 H220" prefix={wide} />
  <Arrow d="M364 92 V128" prefix={wide} />
  <Box x={256} y={132} w={216} h={52} label="@laminapdf/render" sub="what renderers implement" mono />
  <Box x={256} y={224} w={216} h={52} label="@laminapdf/render-pdfium" sub="the default renderer" mono />
  <Arrow d="M364 224 V188" prefix={wide} />
  <Box x={256} y={296} w={216} h={52} label="@laminapdf/render-hayro" sub="a second renderer" mono />
  <Arrow d="M472 322 H480 V158 H476" prefix={wide} />

  <Lane x={504} y={0} w={216} h={112} title="Rust" />
  <Box x={520} y={40} w={184} h={52} label="laminapdf" sub="one crate, with features" mono />
</Svg>

<Svg viewBox="0 0 320 680" layout="narrow" labelledby={labelledby} describedby={describedby}>
  <Markers prefix={narrow} />
  <Lane x={0} y={0} w={320} h={548} title="JavaScript" />
  <Box x={8} y={40} w={304} h={52} label="@laminapdf/sdk" sub="the TypeScript API" mono focus={focus === "sdk"} />
  <Arrow d="M160 92 V118" prefix={narrow} />
  <Box x={8} y={122} w={304} h={52} label="@laminapdf/wasm" sub="WebAssembly" mono />
  <Strip x={8} y={174} h={44} segments={modules(304)} />

  <Box x={8} y={250} w={304} h={52} label="@laminapdf/viewer" sub="uses `@laminapdf/sdk`" mono focus={focus === "viewer"} />
  <Arrow d="M154 302 V328" prefix={narrow} />
  <Box x={8} y={332} w={292} h={52} label="@laminapdf/render" sub="what renderers implement" mono />
  <Box x={8} y={414} w={292} h={52} label="@laminapdf/render-pdfium" sub="the default renderer" mono />
  <Arrow d="M154 414 V388" prefix={narrow} />
  <Box x={8} y={482} w={292} h={52} label="@laminapdf/render-hayro" sub="a second renderer" mono />
  <Arrow d="M300 508 H312 V358 H304" prefix={narrow} />

  <Lane x={0} y={568} w={320} h={108} title="Rust" />
  <Box x={8} y={608} w={304} h={52} label="laminapdf" sub="one crate, with features" mono />
</Svg>
