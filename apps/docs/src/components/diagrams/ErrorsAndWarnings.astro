---
// "Errors and warnings" (concepts/errors-and-warnings, "Every surface has the same fields"): a call
// either stops with a LaminaPdfError or completes with warnings on doc.warnings, and both carry the
// same fields; text from the document goes only in `data`. No accent: both outcomes weigh the same. Caption and
// text description: registry.mjs.
import Arrow from "./kit/Arrow.astro";
import Box from "./kit/Box.astro";
import type { DrawingProps } from "./kit/drawing.ts";
import Label from "./kit/Label.astro";
import Lane from "./kit/Lane.astro";
import Markers from "./kit/Markers.astro";
import Svg from "./kit/Svg.astro";

type Props = DrawingProps;
const { prefix, labelledby, describedby } = Astro.props;
const wide = `${prefix}-wide`;
const narrow = `${prefix}-narrow`;
/** The fields both share, in the page's order; `data` comes last, with its rule beside it. */
const FIELDS = ["code", "kind", "message", "hint", "location", "docsUrl"] as const;
---

<Svg viewBox="0 0 720 256" layout="wide" labelledby={labelledby} describedby={describedby}>
  <Markers prefix={wide} />
  <Box x={0} y={98} w={140} h={56} label="A call" />
  <Arrow d="M140 126 H160" prefix={wide} head={false} />
  <Arrow d="M160 126 V54 H196" prefix={wide} />
  <Arrow d="M160 126 V198 H196" prefix={wide} />
  <Box x={200} y={24} w={230} h={60} label="LaminaPdfError" sub="the call stops" mono />
  <Box x={200} y={168} w={230} h={60} label="doc.warnings" sub="the call completes" mono />
  <Arrow d="M430 54 H466" prefix={wide} />
  <Arrow d="M430 198 H466" prefix={wide} />

  <Lane x={470} y={0} w={250} h={256} title="The same fields" />
  {FIELDS.map((f, i) => <Label x={490} y={60 + i * 26} text={f} kind="mono" />)}
  <Label x={490} y={60 + FIELDS.length * 26} text="data" kind="mono" />
  <Label x={540} y={60 + FIELDS.length * 26} text="the document's text" kind="sub" />
</Svg>

<Svg viewBox="0 0 320 432" layout="narrow" labelledby={labelledby} describedby={describedby}>
  <Markers prefix={narrow} />
  <Box x={80} y={0} w={160} h={48} label="A call" />
  <Arrow d="M160 48 V64" prefix={narrow} head={false} />
  <Arrow d="M160 64 H76 V88" prefix={narrow} />
  <Arrow d="M160 64 H244 V88" prefix={narrow} />
  <Box x={0} y={92} w={152} h={56} label="LaminaPdfError" sub="the call stops" mono />
  <Box x={168} y={92} w={152} h={56} label="doc.warnings" sub="the call completes" mono />
  <Arrow d="M76 148 V180" prefix={narrow} />
  <Arrow d="M244 148 V180" prefix={narrow} />

  <Lane x={0} y={184} w={320} h={244} title="The same fields" />
  {FIELDS.map((f, i) => <Label x={16} y={232 + i * 24} text={f} kind="mono" />)}
  <Label x={16} y={232 + FIELDS.length * 24} text="data" kind="mono" />
  <Label x={64} y={232 + FIELDS.length * 24} text="the document's text" kind="sub" />
</Svg>
