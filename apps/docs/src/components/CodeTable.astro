---
// Every error and warning code, read from fixtures/codes.json at build time (ADR 0026 §3, through
// src/lib/codes.ts): one table per group, in the file's order. Each code links to its page on
// this site (/reference/codes/<code>/, from docs/errors/).
import { CODE_GROUPS as groups } from "../lib/codes";
---

{
  groups.map((g) => (
    <>
      <h2 id={g.key}>{g.title}</h2>
      <table>
        <thead>
          <tr>
            <th>Code</th>
            <th>Kind</th>
            <th>What happened</th>
            <th>What to do</th>
          </tr>
        </thead>
        <tbody>
          {g.entries.map((e) => (
            <tr>
              <td>
                <a href={`/reference/codes/${e.code}/`}>
                  <code>{e.code}</code>
                </a>
              </td>
              <td>
                <code>{e.kind}</code>
              </td>
              <td>{e.summary}</td>
              <td>{e.hint}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </>
  ))
}
