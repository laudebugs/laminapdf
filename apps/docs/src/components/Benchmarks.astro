---
// One section of the benchmarks page, read from src/data/benchmarks.json (written by `cargo xtask
// benchmarks`) through src/lib/benchmarks.ts, which fails the build on a file it doesn't describe.
// The page's Markdown twin shows the same section through `sectionMarkdown` (plugins/agent-docs.mjs).
import data from "../data/benchmarks.json";
import { parseBenchmarks, runSentence, type Section, sectionParts } from "../lib/benchmarks";

interface Props {
  section: Section;
}

const parts = sectionParts(parseBenchmarks(data), Astro.props.section);
const table = parts?.table;
const summary = parts?.summary;
const run = parts?.run;

/** A cell's text split into plain parts and `code` spans. */
function spans(cell: string): { code: boolean; text: string }[] {
  return cell.split("`").map((text, i) => ({ code: i % 2 === 1, text }));
}
---

{
  table === undefined ? (
    <p>Not measured yet.</p>
  ) : (
    <>
      <table class="benchmarks">
        <thead>
          <tr>{table.headers.map((h, i) => <th class={table.numeric[i] ? "num" : undefined}>{h}</th>)}</tr>
        </thead>
        <tbody>
          {table.rows.map((row) => (
            <tr>
              {row.map((cell, i) => (
                <td class={table.numeric[i] ? "num" : undefined}>
                  {spans(cell).map((p) => (p.code ? <code>{p.text}</code> : p.text))}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
      {summary && <p>{summary}</p>}
      {run && (
        <p class="benchmarks-run">
          {spans(runSentence(run)).map((p) => (p.code ? <code>{p.text}</code> : p.text))}
        </p>
      )}
    </>
  )
}

