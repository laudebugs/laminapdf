---
// The docs site's theme switch (Starlight's `ThemeSelect` override, W1g; Q4w) on the sites' Paper
// select (@laminapdf/site-kit's MenuSelect): a button that opens a list of Light, Dark and Auto,
// each with its icon (Sun, Moon, Laptop), instead of the platform's own list. It keeps Starlight's
// contract: a <starlight-theme-select> around the switch, the values `dark`, `light` and `auto`,
// and the choice in localStorage under `starlight-theme`. Starlight's theme provider (an inline
// script in the head) sets the theme before the first paint; its `updatePickers` fills in only a
// native <select>, so the inline script below shows the stored choice in the switch instead. The
// module script is Starlight's own switching logic (@astrojs/starlight/components/ThemeSelect.astro),
// under its names so the two diff easily, with localStorage wrapped for browsers that refuse it; a
// Starlight update that changes that contract needs a look here. The header and the phone menu both
// use this switch.
import laptop from "@laminapdf/icons/svg/laptop.svg?raw";
import moon from "@laminapdf/icons/svg/moon.svg?raw";
import sun from "@laminapdf/icons/svg/sun.svg?raw";
import MenuSelect from "@laminapdf/site-kit/MenuSelect.astro";

const t = Astro.locals.t;
---

<starlight-theme-select>
  <MenuSelect
    label={t("themeSelect.accessibleLabel")}
    hideLabel
    value="auto"
    options={[
      { value: "light", label: t("themeSelect.light"), icon: sun },
      { value: "dark", label: t("themeSelect.dark"), icon: moon },
      { value: "auto", label: t("themeSelect.auto"), icon: laptop },
    ]}
  />
</starlight-theme-select>

{/* Inline, before the first paint: every switch shows the stored choice, as MenuSelect shows a value. */}
<script is:inline>
  (() => {
    let theme = "auto";
    try {
      theme = localStorage.getItem("starlight-theme") || "auto";
    } catch {
      // No storage: Auto.
    }
    for (const menu of document.querySelectorAll("starlight-theme-select site-menu-select")) {
      menu.setAttribute("value", theme);
      for (const current of menu.querySelectorAll("[data-for]")) current.hidden = current.dataset.for !== theme;
    }
  })();
</script>

<script>
  type Theme = "auto" | "dark" | "light";

  /** Where Starlight keeps the choice. */
  const storageKey = "starlight-theme";

  /** A theme from any value; anything unknown is `auto`. */
  const parseTheme = (theme: unknown): Theme =>
    theme === "auto" || theme === "dark" || theme === "light" ? theme : "auto";

  function loadTheme(): Theme {
    try {
      return parseTheme(localStorage.getItem(storageKey));
    } catch {
      return "auto";
    }
  }

  /** Stores the choice; `auto` is stored as no choice, as Starlight does. */
  function storeTheme(theme: Theme): void {
    try {
      localStorage.setItem(storageKey, theme === "auto" ? "" : theme);
    } catch {
      // Storage refused (a private window, blocked site data): the choice lasts for this page.
    }
  }

  const getPreferredColorScheme = (): "dark" | "light" =>
    matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";

  /** Shows `theme` on the page and in every switch on it, and stores it. */
  function onThemeChange(theme: Theme): void {
    for (const menu of document.querySelectorAll("starlight-theme-select site-menu-select")) {
      menu.setAttribute("value", theme);
    }
    document.documentElement.dataset.theme = theme === "auto" ? getPreferredColorScheme() : theme;
    storeTheme(theme);
  }

  // Auto follows the system while the page is open.
  matchMedia("(prefers-color-scheme: light)").addEventListener("change", () => {
    if (loadTheme() === "auto") onThemeChange("auto");
  });

  class ThemeSelect extends HTMLElement {
    constructor() {
      super();
      onThemeChange(loadTheme());
      this.addEventListener("change", (event) => {
        if (event.target instanceof Element) onThemeChange(parseTheme(event.target.getAttribute("value")));
      });
    }
  }
  customElements.define("starlight-theme-select", ThemeSelect);
</script>
