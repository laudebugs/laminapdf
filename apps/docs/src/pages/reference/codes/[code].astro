---
import { getCollection } from "astro:content";
// One page per error and warning code: docs/errors/<code>.md (the page each code's docsUrl
// names in the repository), rendered on the site, with "Edit page" opening that file. plugins/error-pages.mjs
// points its links to other codes at their pages here and drops links to repository files the site doesn't have.
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { errorPageHtml } from "../../../../plugins/error-pages.mjs";
import { EDIT_BASE } from "../../../../plugins/repository.mjs";
import { codeEntry } from "../../../lib/codes";

export async function getStaticPaths() {
  const pages = await getCollection("errors");
  return pages.map((entry) => ({ params: { code: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const html = errorPageHtml(entry.rendered?.html ?? "");
const headings = (entry.rendered?.metadata?.headings ?? []).filter((h) => h.depth > 1);
const summary = codeEntry(entry.id);
---

<StarlightPage
  frontmatter={{
    title: entry.id,
    description: summary?.summary ?? `The ${entry.id} code`,
    editUrl: `${EDIT_BASE}docs/errors/${entry.id}.md`,
  }}
  headings={headings}
>
  <p><a href="/reference/codes/">All codes</a></p>
  <Fragment set:html={html} />
</StarlightPage>
