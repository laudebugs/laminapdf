---
// Every page's frame: the head (title, description, canonical URL on https://laminapdf.com, or
// noindex for a page search engines should skip; the first paint's font preloaded), the site
// header and footer, and the page between them.
import "@laminapdf/tokens/tokens.css";
import "@laminapdf/fonts/fonts.css";
import "../styles/site.css";
// Lamina Sans' Latin file, the one face worth preloading (@laminapdf/fonts' FONT_PRELOADS).
import sans from "@laminapdf/fonts/files/lamina-sans-latin-wght-normal.woff2?url";
import { siteNav } from "@laminapdf/site-kit/nav";
import SiteHeader from "@laminapdf/site-kit/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { OPENING } from "../data/copy.js";

interface Props {
  /** The page's title, as the browser tab and search results show it. */
  title: string;
  /** One or two sentences for search results and link previews. */
  description: string;
  /** Keeps the page out of search results, with no canonical URL: the 404 page. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const links = siteNav(__SITE_PAGES__, { site: "website", path: Astro.url.pathname });
// The share image and the favicons, written by scripts/share-image.mjs. The image shows the
// wordmark and the home page's headline on every page's card, so its alt text says the same.
const shareImage = new URL("/og.png", Astro.site);
const shareAlt = `Lamina PDF: ${OPENING.headline}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical.href} />}
    <link rel="preload" href={sans} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Lamina PDF" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={shareImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareAlt} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to the content</a>
    <header class="site-header">
      <SiteHeader links={links} home="/" />
    </header>
    <main id="content">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
