---
// Every page's frame: the head (title, description, canonical URL on https://laminapdf.com, or
// noindex for a page search engines should skip; the first paint's font preloaded), the site
// header and footer, and the page between them.
import "@laminapdf/tokens/tokens.css";
import "@laminapdf/fonts/fonts.css";
import "../styles/site.css";
// Lamina Sans' Latin file, the one face worth preloading (@laminapdf/fonts' FONT_PRELOADS).
import sans from "@laminapdf/fonts/files/lamina-sans-latin-wght-normal.woff2?url";
import { siteNav } from "@laminapdf/site-kit/nav";
import SiteHeader from "@laminapdf/site-kit/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";

interface Props {
  /** The page's title, as the browser tab and search results show it. */
  title: string;
  /** One or two sentences for search results and link previews. */
  description: string;
  /** Keeps the page out of search results, with no canonical URL: the 404 page. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const links = siteNav(__SITE_PAGES__, { site: "website", path: Astro.url.pathname });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical.href} />}
    <link rel="preload" href={sans} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to the content</a>
    <header class="site-header">
      <SiteHeader links={links} home="/" />
    </header>
    <main id="content">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
