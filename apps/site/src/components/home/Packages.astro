---
// The packages: the two install lines and every published package, read from the docs site's
// install page so the two never disagree, and the command-line tool, not released yet.
import { PACKAGES } from "../../data/copy.js";
import { alphaNote, installLines, packages, VERSION } from "../../data/sources.js";
import Inline from "./Inline.astro";

const [npm, cargo] = installLines();
---

<section id="packages" class="home-section" aria-labelledby="packages-title">
  <h2 id="packages-title">{PACKAGES.heading}</h2>
  <p class="section-intro">{PACKAGES.intro} <Inline text={alphaNote()} /></p>
  <div class="install">
    <div>
      <p class="install-label">{PACKAGES.typescript}</p>
      <pre><code>{npm}</code></pre>
    </div>
    <div>
      <p class="install-label">{PACKAGES.rust}</p>
      <pre><code>{cargo}</code></pre>
    </div>
  </div>
  <div class="table-scroll" role="region" aria-labelledby="packages-caption" tabindex="0">
    <table class="packages">
      <caption id="packages-caption">Every published package, at version {VERSION}</caption>
      <thead>
        <tr>
          <th scope="col">Package</th>
          <th scope="col">Registry</th>
          <th scope="col">What it holds</th>
        </tr>
      </thead>
      <tbody>
        {
          packages().map((item) => (
            <tr>
              <td>
                <a href={item.url}>
                  <code>{item.name}</code>
                </a>
              </td>
              <td>{item.registry}</td>
              <td>
                <Inline text={item.holds} />
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p class="cli-note"><Inline text={PACKAGES.cli} /></p>
</section>
