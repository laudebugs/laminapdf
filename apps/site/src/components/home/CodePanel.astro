---
// A code panel with one tab per language (design: the owner's sample C). The tabs come from
// src/scripts/tabs.ts; without it every pane shows under its own heading, so the code is readable
// with no script at all. The code is coloured at build time (src/data/highlight.ts): each run of
// text is a span whose class site.css colours.
import { type CodeLanguage, highlight } from "../../data/highlight.js";

interface Props {
  /** One pane per tab: its ID, its label, its code and the language it is coloured as. */
  tabs: readonly { id: string; label: string; code: string; lang: CodeLanguage }[];
  caption: string;
}

const { tabs, caption } = Astro.props;
const panes = await Promise.all(tabs.map(async (tab) => ({ ...tab, lines: await highlight(tab.code, tab.lang) })));
---

<figure class="code-panel" data-tabs>
  <div class="code-tabs" data-tablist aria-label="Language" hidden>
    {
      tabs.map((tab) => (
        <button type="button" class="code-tab" id={`tab-${tab.id}`} data-tab>
          {tab.label}
        </button>
      ))
    }
  </div>
  {
    panes.map((pane) => (
      <section class="code-pane" id={`pane-${pane.id}`} data-pane aria-labelledby={`label-${pane.id}`}>
        <h3 class="code-label" id={`label-${pane.id}`}>
          {pane.label}
        </h3>
        <pre tabindex="0"><code>{pane.lines.map((line, index) => <Fragment>{index > 0 ? "\n" : ""}{line.map((run) => (run.kind === undefined ? run.text : <span class={`syntax-${run.kind}`}>{run.text}</span>))}</Fragment>)}</code></pre>
      </section>
    ))
  }
  <figcaption>{caption}</figcaption>
</figure>

<script>
  import "../../scripts/tabs.js";
</script>
