{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "e2e",
  "description": "End-to-end test builds only (feature e2e, enabled by tauri.e2e.conf.json): the test commands and WebdriverIO's plugin. Release builds have neither the file's commands nor the plugin.",
  "windows": ["main", "doc-*"],
  "platforms": ["macOS", "windows", "linux"],
  "permissions": [
    "allow-debug-kill-engine",
    "allow-e2e-queue-pick",
    "allow-e2e-queue-save-as",
    "allow-e2e-queue-folder",
    "allow-e2e-interactive",
    "allow-e2e-focus",
    "allow-e2e-place-cursor",
    "allow-e2e-menu-click",
    "allow-e2e-menu-snapshot",
    "allow-e2e-print-to-file",
    "allow-e2e-crash-main-panic",
    "allow-e2e-crash-engine-panic",
    "allow-e2e-crash-engine-segv",
    "wdio:default"
  ]
}
