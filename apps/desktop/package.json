{
  "name": "@laminapdf/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Lamina PDF's desktop reader: @laminapdf/ui's chrome in a Tauri 2 shell (ADR 0008). The app's version is the Rust crate's (the workspace's lockstep version).",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "tauri": "tauri",
    "desktop:dev": "tauri dev --config src-tauri/tauri.bundle.conf.json",
    "desktop:build": "tauri build --config src-tauri/tauri.bundle.conf.json",
    "typecheck:wasm": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run -c vitest.config.ts",
    "desktop:build:e2e": "tauri build --debug --no-bundle --features e2e --config src-tauri/tauri.bundle.conf.json --config src-tauri/tauri.e2e.conf.json",
    "e2e": "wdio run e2e/wdio.conf.ts"
  },
  "dependencies": {
    "@laminapdf/fonts": "workspace:*",
    "@laminapdf/render": "workspace:*",
    "@laminapdf/tokens": "workspace:*",
    "@laminapdf/ui": "workspace:*",
    "@laminapdf/viewer": "workspace:*",
    "@tauri-apps/api": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@rolldown/plugin-babel": "catalog:",
    "@tauri-apps/cli": "catalog:",
    "@types/babel__core": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@wdio/cli": "catalog:",
    "@wdio/globals": "catalog:",
    "@wdio/local-runner": "catalog:",
    "@wdio/mocha-framework": "catalog:",
    "@wdio/spec-reporter": "catalog:",
    "@wdio/tauri-plugin": "catalog:",
    "@wdio/tauri-service": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "webdriverio": "catalog:"
  }
}
