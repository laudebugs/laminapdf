diff --git a/apps/docs/ec.config.mjs b/apps/docs/ec.config.mjs
new file mode 100644
index 00000000..b3057245
--- /dev/null
+++ b/apps/docs/ec.config.mjs
@@ -0,0 +1,16 @@
+// Spike Q4p: Expressive Code's options, here because <Code> needs them in their own file.
+// Twoslash hover types only when LAMINA_PDF_TWOSLASH=1.
+import { defineEcConfig } from "@astrojs/starlight/expressive-code";
+import ecTwoSlash from "expressive-code-twoslash";
+
+export default defineEcConfig(process.env.LAMINA_PDF_TWOSLASH === "1" ? {
+        plugins: [
+          ecTwoSlash({
+            // The examples run in Node 24 (`node:` imports, `import.meta.main`), like the tsconfig
+            // the SDK's examples are checked with.
+            twoslashOptions: {
+              compilerOptions: { types: ["node"], module: 99, moduleResolution: 100, target: 99, lib: ["lib.esnext.d.ts", "lib.dom.d.ts"] },
+            },
+          }),
+        ],
+      } : {});
