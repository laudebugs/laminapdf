$ laminapdf info scan.pdf --json --fields pages,encrypted,warnings
{"encrypted":false,"input":"scan.pdf","pages":1,"schema":"laminapdf.info/1","warnings":[{"code":"xref-repaired","docsUrl":"https://github.com/laudebugs/laminapdf/blob/main/docs/errors/xref-repaired.md","hint":"check the result; save with a full rewrite, since an incremental update refuses a repaired base","kind":"input","message":"the stored cross-reference data was unusable and was rebuilt by scanning"}]}
